{
  "name": "Dee Mensagens",
  "short_name": "Dee",
  "description": "Dee Mensagens é um aplicativo de mensagens instantâneas que permite enviar mensagens de texto, fotos, vídeos e áudios para seus amigos e familiares. Com uma interface simples e intuitiva, você pode se conectar com pessoas em todo o mundo de forma rápida e segura.",
  "start_url": "./index.html",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#030508",
  "theme_color": "#00e5cc",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "social",
    "communication"
  ],
  "lang": "pt-BR",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "shared_files",
          "accept": ["image/*", "audio/*", "application/pdf", "text/plain", ".doc", ".docx", ".xls", ".xlsx", ".zip"]
        }
      ]
    }
  }
}